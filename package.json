{
  "name": "dsh-model-panel",
  "version": "0.7.4",
  "description": "Searchable provider/model table in the DSH composer: per-model discount chips, balance and plan rows, per-session subagent switch.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "model-picker",
    "balance",
    "credits"
  ],
  "type": "module",
  "license": "MIT",
  "author": "poloniumn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poloniumn/dsh-model-panel.git"
  },
  "homepage": "https://github.com/poloniumn/dsh-model-panel#readme",
  "bugs": {
    "url": "https://github.com/poloniumn/dsh-model-panel/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib",
    "assets",
    "images",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check client.shared.js && node --check client.css.js && node --check client.panel.js && node --check client.settings.js && node --check test/run.mjs",
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
